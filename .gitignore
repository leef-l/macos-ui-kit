# Wails build artefacts
.task
.wails
bin
build/bin

# Frontend build output and dependencies
frontend/dist
frontend/node_modules
frontend/dist-smoke

# The UI kit package builds its own dist and installs its own dependencies, so
# it is consumed as a normal npm package rather than as part of the app build.
packages/*/dist
packages/*/node_modules

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.syso

# Editor and OS noise
.DS_Store
Thumbs.db
.idea
.vscode
*.swp

# Scratch files used while verifying the UI kit. These are throwaway harnesses
# (headless-browser drivers, temporary entry points); keeping them out of the
# repository stops debug leftovers being published.
frontend/src/__*
frontend/__*
frontend/*.smoke.*
frontend/dist-smoke
smoke-dump.html
